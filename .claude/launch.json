{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "trading-pedro",
      "runtimeExecutable": "python",
      "runtimeArgs": ["trading_pedro.py", "--no-browser", "--port", "8051"],
      "port": 8051,
      "autoPort": false
    },
    {
      "name": "trading-pedro-html",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8056", "--bind", "127.0.0.1"],
      "port": 8056,
      "autoPort": false
    }
  ]
}
